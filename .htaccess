# Redirections 301 des anciennes URL du site v1 (référencées par Google)
# vers leurs équivalents sur le nouveau site.
Redirect 301 /retable.html /qu-est-ce-qu-un-retable.html
Redirect 301 /activites.html /generic.html
Redirect 301 /visiteDesEglises.html /depliants-eglises.html
Redirect 301 /livre.html /boutique.html#section_livre

# Cache : le navigateur doit revérifier HTML/JS/CSS à chaque visite (réponse 304
# si inchangé), sinon une mise à jour de js/content.js peut rester invisible
# plusieurs heures. Les images gardent le cache par défaut.
<IfModule mod_headers.c>
    <FilesMatch "\.(html|js|css)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
